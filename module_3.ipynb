    "def segment_and_extract_respiration(ref_respiration, dev_ip, dev_gyr, fs=250):\n",
    "    resp_sig_len = min([len(ref_respiration), len(dev_ip), len(dev_gyr)])\n",
    "    resp_window_sec = 30\n",
    "    resp_step_sec=30\n",
    "\n",
    "    resp_W = int(resp_window_sec * fs)\n",
    "    resp_step = int(resp_step_sec * fs)\n",
    "    resp_segments = [(s, s + resp_W) for s in range(0, resp_sig_len - resp_W + 1, resp_step)]\n",
    "\n",
    "    resp_ip_all_segs = []\n",
    "    resp_gyr_all_segs = []\n",
    "    final_rr = []\n",
    "    resp_ref_all_segs = []\n",
    "\n",
    "    dev_ip_peaks_all_segs = []\n",
    "    dev_gyr_peaks_all_segs = []\n",
    "    ref_resp_peaks_all_segs = []\n",
    "\n",
    "    spi_ip_all_segs = []\n",
    "    spi_gyr_all_segs = []\n",
    "    spi_ref_all_segs = []\n",
    "\n",
    "    for i, (s, e) in enumerate(resp_segments):\n",
    "\n",
    "        ip_peaks = _get_resp_peaks(dev_ip[s:e])\n",
    "        resp_ip = _resp_rate_from_peaks(ip_peaks)\n",
    "        spi_ip = segment_spi(dev_ip[s:e])\n",
    "        \n",
    "        gyr_peaks = _get_resp_peaks(dev_gyr[s:e])\n",
    "        resp_gyr = _resp_rate_from_peaks(gyr_peaks)\n",
    "        spi_gyr = segment_spi(dev_gyr[s:e])\n",
    "\n",
    "        ref_peaks = _get_resp_peaks(ref_respiration[s:e])\n",
    "        resp_ref = _resp_rate_from_peaks(ref_peaks)\n",
    "        spi_ref = segment_spi(ref_respiration[s:e])\n",
    "\n",
    "        resp_ip_all_segs.append(resp_ip)\n",
    "        resp_gyr_all_segs.append(resp_gyr)\n",
    "        resp_ref_all_segs.append(resp_ref)\n",
    "        \n",
    "        '''\n",
    "        adding segment along with the extracted peaks for diagnosis purposes;\n",
    "        Not returning it for now, but just need to return following three arrays\n",
    "        if needed\n",
    "        '''\n",
    "        dev_ip_peaks_all_segs.append((dev_ip[s:e], ip_peaks))\n",
    "        dev_gyr_peaks_all_segs.append((dev_gyr[s:e], gyr_peaks))\n",
    "        ref_resp_peaks_all_segs.append((ref_respiration[s:e], ref_peaks))\n",
    "        \n",
    "        spi_ip_all_segs.append(spi_ip)\n",
    "        spi_gyr_all_segs.append(spi_gyr)\n",
    "        spi_ref_all_segs.append(spi_ref)\n",
    "\n",
    "        ip_nan = np.isnan(resp_ip)\n",
    "        gyr_nan = np.isnan(resp_gyr)\n",
    "\n",
    "        if ip_nan and gyr_nan:\n",
    "            final_rr.append(float('nan'))\n",
    "        elif ip_nan or gyr_nan:\n",
    "            final_rr.append(float(resp_gyr if ip_nan else resp_ip))\n",
    "        else:\n",
    "            final_rr.append(float(np.average([resp_ip, resp_gyr])))\n",
    "\n",
    "    resp_error = []\n",
    "    for idx, rr in enumerate(final_rr):\n",
    "        resp_error.append(abs(rr - resp_ref_all_segs[idx]))\n",
    "\n",
    "    return resp_ip_all_segs, resp_gyr_all_segs, final_rr, resp_ref_all_segs, resp_error, spi_ip_all_segs, spi_gyr_all_segs, spi_ref_all_segs, dev_ip_peaks_all_segs, dev_gyr_peaks_all_segs, ref_resp_peaks_all_segs"
   ]
  },
