    "def segment_and_extract_ecg(ref_lead2, dev_lead2, fs=250):\n",
    "\n",
    "    min_len = min(len(ref_lead2), len(dev_lead2))\n",
    "    hr_window_sec = 10\n",
    "    \n",
    "    W_hr    = int(hr_window_sec * fs)\n",
    "    step_hr = W_hr                                  # non-overlapping\n",
    "    n_hr    = min_len // W_hr\n",
    "    segments_hr = [(i * step_hr, i * step_hr + W_hr) for i in range(n_hr)]\n",
    "\n",
    "    dev_hr_all_segs = []\n",
    "    ref_hr_all_segs = []\n",
    "\n",
    "    dev_r_peaks_all_segs = []\n",
    "    ref_r_peaks_all_segs = []\n",
    "\n",
    "    dev_tm_score_all_segs = []\n",
    "    ref_tm_score_all_segs = []\n",
    "\n",
    "    dev_rmssd_all_segs = []\n",
    "    ref_rmssd_all_segs = []\n",
    "\n",
    "    for i, (s, e) in enumerate(segments_hr):\n",
    "        dev_peaks, dev_hr = get_hr(dev_lead2[s:e])\n",
    "        ref_peaks, ref_hr = get_hr(ref_lead2[s:e])\n",
    "        \n",
    "        dev_hr_all_segs.append(dev_hr)\n",
    "        ref_hr_all_segs.append(ref_hr)\n",
    "\n",
    "        dev_r_peaks_all_segs.append((dev_lead2[s:e], dev_peaks))\n",
    "        ref_r_peaks_all_segs.append((ref_lead2[s:e], ref_peaks))\n",
    "\n",
    "        dev_tm_sqi, clean_dev_peaks = get_beat_quality_scores(dev_lead2[s:e], dev_peaks)\n",
    "        ref_tm_sqi, clean_ref_peaks = get_beat_quality_scores(ref_lead2[s:e], ref_peaks)\n",
    "\n",
    "        dev_tm_score_all_segs.append(dev_tm_sqi)\n",
    "        ref_tm_score_all_segs.append(ref_tm_sqi)\n",
    "\n",
    "        dev_rmssd = get_rmssd(dev_peaks)\n",
    "        ref_rmssd = get_rmssd(ref_peaks)\n",
    "\n",
    "        dev_rmssd_all_segs.append(dev_rmssd)\n",
    "        ref_rmssd_all_segs.append(ref_rmssd)\n",
    "\n",
    "    hr_error = []\n",
    "    for idx, hr in enumerate(dev_hr_all_segs):\n",
    "        hr_error.append(abs(hr - ref_hr_all_segs[idx]))\n",
    "\n",
    "    rmssd_error = []\n",
    "    for idx, rmssd in enumerate(dev_rmssd_all_segs):\n",
    "        rmssd_error.append(abs(rmssd - ref_rmssd_all_segs[idx]))\n",
    "    \n",
    "\n",
    "\n",
    "    return dev_hr_all_segs, ref_hr_all_segs, hr_error, dev_tm_score_all_segs, ref_tm_score_all_segs, dev_rmssd_all_segs, ref_rmssd_all_segs, rmssd_error, dev_r_peaks_all_segs, ref_r_peaks_all_segs"
   ]
  },
