    "rows = []  # collect dicts, build DataFrame once at the end (much faster than repeated pd.concat)\n",
    "segments_store = {}\n",
    "\n",
    "def add_metric(rows, subject, config, activity, modality, metric, device_vals, reference_vals=None):\n",
    "    \"\"\"\n",
    "    Append one row per element to `rows` in long format.\n",
    "\n",
    "    device_vals / reference_vals can be a scalar, list, or np.array.\n",
    "    If reference_vals is None, 'reference' is set to NaN for every row\n",
    "    (use this for metrics that only exist on one side, e.g. a\n",
    "    reference-only signal quality score).\n",
    "    \"\"\"\n",
    "    device_vals = np.atleast_1d(device_vals)\n",
    "\n",
    "    if reference_vals is None:\n",
    "        reference_vals = np.full(len(device_vals), np.nan)\n",
    "    else:\n",
    "        reference_vals = np.atleast_1d(reference_vals)\n",
    "        if len(reference_vals) != len(device_vals):\n",
    "            raise ValueError(\n",
    "                f\"Length mismatch for metric='{metric}' modality='{modality}': \"\n",
    "                f\"device has {len(device_vals)}, reference has {len(reference_vals)}\"\n",
    "            )\n",
    "\n",
    "    for dev_val, ref_val in zip(device_vals, reference_vals):\n",
    "        rows.append({\n",
    "            'subject': subject,\n",
    "            'activity': activity,\n",
    "            'config': config,\n",
    "            'modality': modality,\n",
    "            'metric': metric,\n",
    "            'device': dev_val,\n",
    "            'reference': ref_val\n",
    "        })\n",
    "\n",
    "\n",
    "for act in activity:\n",
    "    for config in configs:\n",
    "        for sub in subjects:\n",
    "\n",
    "            try:\n",
    "                dev_ip = data[f\"subject_{sub}/{config}/{act}\"][\"respiration\"][\"dev_ip\"]\n",
    "                dev_gyr = data[f\"subject_{sub}/{config}/{act}\"][\"respiration\"][\"dev_gyr\"]\n",
    "                ref_resp = data[f\"subject_{sub}/{config}/{act}\"][\"respiration\"][\"ref_respiration\"]\n",
    "\n",
    "                dev_lead2 = data[f\"subject_{sub}/{config}/{act}\"][\"ecg\"][\"dev_lead2\"]\n",
    "                ref_lead2 = data[f\"subject_{sub}/{config}/{act}\"][\"ecg\"][\"ref_lead2\"]\n",
    "\n",
    "                ip_rr, gyr_rr, dev_rr, ref_rr, resp_error, spi_ip, spi_gyr, spi_ref, \\\n",
    "                    dev_ip_segs, dev_gyr_segs, ref_resp_segs = segment_and_extract_respiration(ref_resp, dev_ip, dev_gyr)\n",
    "                dev_hr, ref_hr, hr_error, dev_tm_score, ref_tm_score, \\\n",
    "                    dev_rmssd, ref_rmssd, rmssd_error, dev_lead2_segs, ref_lead2_segs = segment_and_extract_ecg(ref_lead2, dev_lead2)\n",
    "                subj_label = f\"subject_{sub}\"\n",
    "\n",
    "                seg_key = (subj_label, config, act)\n",
    "                segments_store[seg_key] = {\n",
    "                    'dev_ip':   dev_ip_segs,    # list of (signal, peaks) tuples\n",
    "                    'dev_ip_rr': ip_rr,\n",
    "                    'dev_gyr':  dev_gyr_segs,\n",
    "                    'dev_gyr_rr': gyr_rr,\n",
    "                    'ref_resp': ref_resp_segs,\n",
    "                    'ref_resp_rr': ref_rr,\n",
    "                    'dev_resp_rr': dev_rr,\n",
    "                    'dev_ecg':  dev_lead2_segs,\n",
    "                    'ref_ecg':  ref_lead2_segs,\n",
    "                }\n",
    "\n",
    "                # --- ECG metrics (modality = lead2) ---\n",
    "                add_metric(rows, subj_label, config, act, 'lead2', 'mean_hr',  dev_hr,       ref_hr)\n",
    "                add_metric(rows, subj_label, config, act, 'lead2', 'rmssd',    dev_rmssd,    ref_rmssd)\n",
    "                add_metric(rows, subj_label, config, act, 'lead2', 'tm_score', dev_tm_score, ref_tm_score)\n",
    "\n",
    "                # --- Respiration metrics ---\n",
    "                add_metric(rows, subj_label, config, act, 'resp', 'resp_rate', dev_rr, ref_rr)\n",
    "                add_metric(rows, subj_label, config, act, 'resp', 'ip_resp_rate', ip_rr, ref_rr)\n",
    "                add_metric(rows, subj_label, config, act, 'resp', 'gyr_resp_rate', gyr_rr, ref_rr)\n",
    "                add_metric(rows, subj_label, config, act, 'ip',   'spi', spi_ip, spi_ref) \n",
    "                add_metric(rows, subj_label, config, act, 'gyr',  'spi', spi_gyr, spi_ref)\n",
    "\n",
    "            except Exception as e:\n",
    "                print(f\"  FAILED subject_{sub}/{config}/{act}: {type(e).__name__}: {e}\")\n",
    "                continue\n",
    "\n",
    "metrics_df = pd.DataFrame(rows)"
   ]
  },
