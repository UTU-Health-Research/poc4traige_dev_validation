    "def plot_resp_segments(segments_store, key, segment_idx=0, fs=250):\n",
    "    segs = segments_store[key]\n",
    "\n",
    "    ip_sig,  ip_peaks  = segs['dev_ip'][segment_idx]\n",
    "    gyr_sig, gyr_peaks = segs['dev_gyr'][segment_idx]\n",
    "    ref_sig, ref_peaks = segs['ref_resp'][segment_idx]\n",
    "\n",
    "    ip_rr      = segs['dev_ip_rr'][segment_idx]\n",
    "    gyr_rr     = segs['dev_gyr_rr'][segment_idx]\n",
    "    dev_rr     = segs['dev_resp_rr'][segment_idx]\n",
    "    ref_rr     = segs['ref_resp_rr'][segment_idx]\n",
    "\n",
    "    t = np.arange(len(ref_sig)) / fs\n",
    "\n",
    "    def rr_str(val):\n",
    "        return f\"{val:.1f} br/min\" if not np.isnan(float(val)) else \"NaN\"\n",
    "\n",
    "    fig, axes = plt.subplots(2, 1, figsize=(14, 7), sharex=True)\n",
    "    fig.suptitle(f\"{key}  |  Segment {segment_idx}\", fontsize=13)\n",
    "\n",
    "    # --- IP vs Ref ---\n",
    "    ax = axes[0]\n",
    "    ax.plot(t, ip_sig,  label=f'IP  (RR={rr_str(ip_rr)})',  color='steelblue', lw=1.2)\n",
    "    ax.plot(t, ref_sig, label=f'Ref (RR={rr_str(ref_rr)})', color='coral',     lw=1.2, alpha=0.8)\n",
    "    ax.scatter(t[ip_peaks],  ip_sig[ip_peaks],  color='steelblue', marker='v', zorder=5, s=60)\n",
    "    ax.scatter(t[ref_peaks], ref_sig[ref_peaks], color='coral',    marker='v', zorder=5, s=60)\n",
    "    ax.set_ylabel('Amplitude')\n",
    "    ax.set_title('IP vs Reference Respiration')\n",
    "    ax.legend(loc='upper right', fontsize=10)\n",
    "    ax.grid(True, alpha=0.3)\n",
    "    ax.text(0.01, 0.05, f\"Fused dev RR: {rr_str(dev_rr)}\",\n",
    "            transform=ax.transAxes, fontsize=10,\n",
    "            bbox=dict(boxstyle='round,pad=0.3', facecolor='lightyellow', alpha=0.8))\n",
    "\n",
    "    # --- GYR vs Ref ---\n",
    "    ax = axes[1]\n",
    "    ax.plot(t, gyr_sig, label=f'GYR (RR={rr_str(gyr_rr)})', color='mediumseagreen', lw=1.2)\n",
    "    ax.plot(t, ref_sig, label=f'Ref (RR={rr_str(ref_rr)})', color='coral',          lw=1.2, alpha=0.8)\n",
    "    ax.scatter(t[gyr_peaks], gyr_sig[gyr_peaks], color='mediumseagreen', marker='v', zorder=5, s=60)\n",
    "    ax.scatter(t[ref_peaks], ref_sig[ref_peaks],  color='coral',          marker='v', zorder=5, s=60)\n",
    "    ax.set_ylabel('Amplitude')\n",
    "    ax.set_xlabel('Time (s)')\n",
    "    ax.set_title('GYR vs Reference Respiration')\n",
    "    ax.legend(loc='upper right', fontsize=10)\n",
    "    ax.grid(True, alpha=0.3)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
